# Copy this file to .env and fill in what you use. .env is never committed.

# ElevenLabs voiceover: https://elevenlabs.io/app/developers/api-keys (the key starts with sk_)
ELEVENLABS_API_KEY=

# OpenRouter: many speech models behind one key (Microsoft MAI-Voice with native Russian
# voices, Gemini TTS, ElevenLabs, MiniMax, Fish Audio…): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Openverse (CC images and audio search): node kit.mjs media openverse-register --email …
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
