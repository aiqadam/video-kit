{
  "name": "ai-qadam-video-kit",
  "version": "0.1.0",
  "description": "Make promo and product videos by talking to your coding agent: a brief, scenes in HTML, voiceover, music and a render, on an open-source stack.",
  "license": "MIT",
  "author": "AI Qadam Community",
  "homepage": "https://github.com/aiqadam/video-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiqadam/video-kit.git"
  },
  "bugs": {
    "url": "https://github.com/aiqadam/video-kit/issues"
  },
  "type": "module",
  "bin": {
    "video-kit": "bin/video-kit.mjs"
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "tts",
    "skills",
    "templates",
    "videos",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "README.md",
    "CREDITS.md",
    "LICENSE",
    "CONTRIBUTING.md",
    ".env.example",
    ".gitignore"
  ],
  "scripts": {
    "kit": "node bin/video-kit.mjs",
    "doctor": "node bin/video-kit.mjs doctor"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "hyperframes": "0.8.212"
  }
}
