      "lines": [
        {
          "id": "01",
          "at": 0.3,
          "text": "In Uzbek, qadam means a step."
        },
        {
          "id": "01b",
          "at": 3.2,
          "text": "A video takes seven of them."
        }
      ]
    },
    {
      "id": "prompt",
      "dur": 3.84,
      "lines": [
        {
          "id": "02",
          "at": 0.3,
          "text": "You describe it. The agent walks the steps."
        }
      ]
    },
    {
      "id": "brief",
      "dur": 5.76,
      "lines": [
        {
          "id": "03",
          "at": 0.2,
          "text": "First, it writes down every claim, and where it came from."
        }
      ]
    },
    {
      "id": "timeline",
      "dur": 5.76,
      "lines": [
        {
          "id": "04",
          "at": 0.2,
          "text": "This very sentence is a line in the timeline. You're hearing it now."
        }
      ]
    },
    {
      "id": "media",
      "dur": 5.76,
      "lines": [
        {
          "id": "05",
          "at": 0.2,
          "text": "Footage and music arrive with their license and author on record."
        }
      ]
    },
    {
      "id": "scenes",
      "dur": 5.76,
      "lines": [
        {
          "id": "06",
          "at": 0.2,
          "text": "Scenes are plain HTML. The agent looks at the frames before you do."
        }
      ]
    },
    {
      "id": "voice",
      "dur": 5.76,
      "lines": [
        {
          "id": "07",
          "at": 0.2,
          "text": "Every voice take is transcribed back and checked against the script."
        }
      ]
    },
    {
      "id": "render",
      "dur": 5.76,
      "lines": [
        {
          "id": "07b",
          "at": 2.5,
          "text": "Then it renders the video. This one."
        }
      ]
    },
    {
      "id": "honest",
      "dur": 5.76,
      "lines": [
        {
          "id": "08",
          "at": 0.2,
          "text": "And it tells you what it couldn't check."
        }
      ]
    },
